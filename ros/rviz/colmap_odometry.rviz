Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Reference1
        - /Odometry results1
        - /Odometry results1/Sparse stereo RGB cloud1
        - /Stereo input1
        - /Stereo input1/Right camera1/Status1
        - /Tracks1
        - /Diagnostics1/Feature matches1
      Splitter Ratio: 0.550000011920929
    Tree Height: 140
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
